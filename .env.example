APP_NAME="DarsYar"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Tehran
APP_KEY=darsyar_change_this_to_a_random_32_char_secret_key
APP_DEFAULT_LOCALE=fa
APP_DEFAULT_THEME=light

# Database: mysql (recommended for cPanel) or sqlite (for local zero-config/testing)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edunexus_school
DB_USERNAME=root
DB_PASSWORD=

# Skyroom Online Classroom Provider
SKYROOM_ENABLED=false
SKYROOM_API_URL=https://www.skyroom.online/skyroom/api/
SKYROOM_API_KEY=

# Optional Mail & SMS Hooks
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=noreply@darsyar.school
MAIL_FROM_NAME="DarsYar School"
SMS_ENABLED=false
SMS_PROVIDER=none
SMS_API_KEY=
