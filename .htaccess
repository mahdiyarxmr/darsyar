<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive files and directories
    RewriteRule ^(\.env|composer\.(json|lock)|README\.md|.*\.md)$ - [F,L]
    RewriteRule ^(app|bin|config|database|lang|storage|tests)/ - [F,L]

    # Route everything cleanly to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
